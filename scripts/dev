#!/bin/bash
# Usage: scripts/dev [test|test-one <Target/Suite[/test]>|test-all|build|run|dmg|cities]
#   test      core + snapshot tests (default; what pre-push runs)
#   test-one  one suite or test, e.g. TimezoneCoreTests/ZoneEditingTests or TimezoneTests/PanelSnapshotTests/homeZone24Hour()
#   test-all  adds the UI smoke test (takes over the mouse ~10 s), exports screenshots to build/screenshots/
#   build     builds the app without opening it
#   run       builds and opens the app
#   dmg       builds the Release app into build/Timezone.dmg (needs `brew install create-dmg`; VERSION=1.2.3 sets its version)
#   cities    regenerates Core/cities.tsv from GeoNames cities15000 (CC BY 4.0, ADR-0003); needs network
# Output keeps results, real errors and test prints starting "DEBUG: "; VERBOSE=1 shows the full xcodebuild log.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

DD="$HOME/Library/Developer/Xcode/DerivedData/Timezone-cli"
F='^DEBUG: |[0-9]: error:|^error:|✘|↳ (Recorded|Snapshot|Expectation)|✔ Test run|Test Case .* (passed|failed)|\*\* (TEST|BUILD)'
filter() { if [ -n "${VERBOSE:-}" ]; then cat; else grep -E "$F" || true; fi; }
xcb() { xcodebuild "$@" -scheme Timezone -destination "${DEST:-platform=macOS}" -derivedDataPath "$DD" 2>&1 | filter; }

if [ "${1:-}" = cities ]; then
  # "city<TAB>country code<TAB>IANA time zone", most populous first (GeoNames columns 15, 2, 9, 18 = population, name, country, tz).
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  curl -sSL https://download.geonames.org/export/dump/cities15000.zip -o "$tmp/c.zip"
  unzip -oq "$tmp/c.zip" -d "$tmp"
  awk -F'\t' '{print $15 "\t" $2 "\t" $9 "\t" $18}' "$tmp/cities15000.txt" | sort -t$'\t' -k1,1nr -s | cut -f2- > Core/cities.tsv
  wc -l Core/cities.tsv
  exit
fi

xcodegen --quiet
case "${1:-test}" in
  test)
    xcb test -only-testing:TimezoneCoreTests -only-testing:TimezoneTests ;;
  test-one)
    xcb test -only-testing:"${2:?usage: scripts/dev test-one <Target/Suite[/test]>}" ;;
  test-all)
    rm -rf build
    status=0
    xcb test -resultBundlePath build/Tests.xcresult || status=$?
    xcrun xcresulttool export attachments --path build/Tests.xcresult --output-path build/screenshots >/dev/null
    echo "Screenshots in build/screenshots/ (manifest.json maps names)"
    exit $status ;;
  build)
    xcb build ;;
  run)
    xcb build
    open "$DD/Build/Products/Debug/Timezone.app" ;;
  dmg)
    # Ad-hoc signed, not notarized (no Apple Developer membership): people confirm it once with Open Anyway.
    # The generic destination builds Apple Silicon and Intel; "platform=macOS" would build only this Mac's.
    DEST='generic/platform=macOS' xcb build -configuration Release ${VERSION:+MARKETING_VERSION=$VERSION}
    rm -rf build/dmg build/Timezone.dmg
    mkdir -p build/dmg
    cp -R "$DD/Build/Products/Release/Timezone.app" build/dmg/
    swift scripts/release/background.swift scripts/release/background.svg build/dmg-background.tiff
    # Icon centres match the drag path in scripts/release/background.svg; the height adds the title bar to the 400 pt image.
    create-dmg --volname Timezone --background build/dmg-background.tiff --window-size 660 428 \
      --icon-size 120 --text-size 13 --icon Timezone.app 180 192 --hide-extension Timezone.app \
      --app-drop-link 484 192 build/Timezone.dmg build/dmg >/dev/null
    echo "build/Timezone.dmg" ;;
  *)
    sed -n '2,10p' "$0"; exit 64 ;;
esac
