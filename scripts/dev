#!/bin/bash
# Usage: scripts/dev [test|test-one <Target/Suite[/test]>|test-all|run|cities]
#   test      core + snapshot tests (default; what pre-push runs)
#   test-one  one suite or test, e.g. TimezoneCoreTests/ZoneEditingTests or TimezoneTests/PanelSnapshotTests/homeZone24Hour()
#   test-all  adds the UI smoke test (takes over the mouse ~10 s), exports screenshots to build/screenshots/
#   run       builds and opens the app
#   cities    regenerates Core/cities.tsv from GeoNames cities15000 (CC BY 4.0, ADR-0003); needs network
# Output keeps results, real errors and test prints starting "DEBUG: "; VERBOSE=1 shows the full xcodebuild log.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

DD="$HOME/Library/Developer/Xcode/DerivedData/Timezone-cli"
F='^DEBUG: |[0-9]: error:|^error:|✘|↳ (Recorded|Snapshot|Expectation)|✔ Test run|Test Case .* (passed|failed)|\*\* (TEST|BUILD)'
filter() { if [ -n "${VERBOSE:-}" ]; then cat; else grep -E "$F" || true; fi; }
xcb() { xcodebuild "$@" -scheme Timezone -destination 'platform=macOS' -derivedDataPath "$DD" 2>&1 | filter; }

if [ "${1:-}" = cities ]; then
  # "city<TAB>country code<TAB>IANA time zone", most populous first (GeoNames columns 15, 2, 9, 18 = population, name, country, tz).
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  curl -sSL https://download.geonames.org/export/dump/cities15000.zip -o "$tmp/c.zip"
  unzip -oq "$tmp/c.zip" -d "$tmp"
  awk -F'\t' '{print $15 "\t" $2 "\t" $9 "\t" $18}' "$tmp/cities15000.txt" | sort -t$'\t' -k1,1nr -s | cut -f2- > Core/cities.tsv
  wc -l Core/cities.tsv
  exit
fi

xcodegen --quiet
case "${1:-test}" in
  test)
    xcb test -only-testing:TimezoneCoreTests -only-testing:TimezoneTests ;;
  test-one)
    xcb test -only-testing:"${2:?usage: scripts/dev test-one <Target/Suite[/test]>}" ;;
  test-all)
    rm -rf build
    status=0
    xcb test -resultBundlePath build/Tests.xcresult || status=$?
    xcrun xcresulttool export attachments --path build/Tests.xcresult --output-path build/screenshots >/dev/null
    echo "Screenshots in build/screenshots/ (manifest.json maps names)"
    exit $status ;;
  run)
    xcb build
    open "$DD/Build/Products/Debug/Timezone.app" ;;
  *)
    sed -n '2,8p' "$0"; exit 64 ;;
esac
